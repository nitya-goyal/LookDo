# LookDo Environment Configuration

# --- Required ---
# Your Google AI Studio API key (works for both Gemini and Gemma models)
GEMINI_API_KEY=

# --- Optional ---
# AI provider: 'auto' (default), 'gemma', 'gemini', or 'mock'
# 'auto' uses GemmaAIService when GEMINI_API_KEY is set, otherwise Mock.
LOOKDO_AI_PROVIDER=auto

# Gemma model to use (same model retried once; explicit mock fallback on failure)
# Default: gemma-4-31b-it
# LOOKDO_GEMMA_MODEL=gemma-4-31b-it

# Gemini model (only used when LOOKDO_AI_PROVIDER=gemini)
# Default: gemini-2.5-flash
# LOOKDO_GEMINI_MODEL=gemini-2.5-flash
